#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <33 34>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <34 35>;
        };

        WheelClick {
            bindings = <&mkp MB3>;
            key-positions = <33 35>;
        };

        BrowserBack {
            bindings = <&mkp MB4>;
            key-positions = <19 20>;
        };

        BrowserForward {
            bindings = <&mkp MB5>;
            key-positions = <20 21>;
        };

        Layer1 {
            bindings = <&mo 1>;
            key-positions = <34 33>;
        };

        Layer2 {
            bindings = <&mo 2>;
            key-positions = <34 35>;
        };
    };

    behaviors {
        mt_balanced: mt_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none      &none  &none  &none  &none  &none                             &none                 &none  &none      &none         &none                        &none
&kp LANG2  &kp Q  &kp W  &kp E  &kp R  &kp T                             &kp Y                 &kp U  &kp I      &kp O         &kp P                        &kp LANG1
&kp TAB    &kp A  &kp S  &kp D  &kp F  &kp G            &none  &none     &kp H                 &kp J  &kp K      &kp L         &mt_balanced LCTRL MINUS     &kp RIGHT_SHIFT
&kp ESC    &kp Z  &kp X  &kp C  &kp V  &kp B            &none  &none     &kp N                 &kp M  &kp COMMA  &kp PERIOD    &mt_balanced LEFT_ALT SLASH  &kp LEFT_GUI
&none      &none  &none  &none  &mo 1  &lt 3 LS(SPACE)  &mo 2  &kp BSPC  &mt LEFT_SHIFT ENTER  &none  &none      &bt BT_SEL 0  &bt BT_SEL 1                 &bt BT_SEL 2
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans   &trans   &trans  &trans                   &trans     &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2   &kp N3   &kp N4  &kp N5                   &kp N6     &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &kp F6  &kp F7   &kp F8   &kp F9  &kp F10  &trans  &trans  &kp COLON  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4  &kp F5   &trans  &trans  &kp TILDE  &kp N1  &kp N2  &kp N3  &trans  &trans
&trans  &trans  &kp F11  &kp F12  &trans  &trans   &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans  &trans       &trans                           &trans         &trans         &trans    &trans      &trans         &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4       &kp F5                           &kp PAGE_UP    &kp BACKSPACE  &kp UP    &kp DELETE  &trans         &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9       &kp F10          &trans  &trans  &kp HOME       &kp LEFT       &kp DOWN  &kp RIGHT   &mt RCTRL END  &trans
&trans  &kp F11  &kp F12  &none   &kp C_PAUSE  &kp PRINTSCREEN  &trans  &trans  &kp PAGE_DOWN  &trans         &trans    &trans      &trans         &trans
&trans  &trans   &trans   &trans  &trans       &trans           &trans  &trans  &trans         &trans         &trans    &trans      &trans         &trans
            >;
        };
    };
};
