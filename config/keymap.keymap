#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <33 34>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <34 35>;
        };

        WheelClick {
            bindings = <&mkp MB3>;
            key-positions = <33 35>;
        };

        BrowserBack {
            bindings = <&mkp MB4>;
            key-positions = <19 20>;
        };

        BrowserForward {
            bindings = <&mkp MB5>;
            key-positions = <20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none      &none      &none         &none         &none  &none                                          &none  &none  &none      &none           &none            &none
&kp TAB    &kp Q      &kp W         &kp E         &kp R  &kp T                                          &kp Y  &kp U  &kp I      &kp O           &kp P            &kp BSPC
&kp CAPS   &kp A      &kp S         &kp D         &kp F  &kp G  &none                 &none             &kp H  &kp J  &kp K      &kp L           &mt LCTRL MINUS  &kp ENTER
&kp LSHFT  &kp Z      &kp X         &kp C         &kp V  &kp B  &kp ESC               &kp ESC           &kp N  &kp M  &kp COMMA  &kp DOT         &msc SCRL_UP     &kp RSHFT
&kp LCTRL  &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1  &mo 2  &mt LEFT_SHIFT SPACE  &mt RSHIFT ENTER  &mo 3  &none  &none      &msc SCRL_LEFT  &msc SCRL_DOWN   &msc SCRL_RIGHT
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans           &trans         &trans            &trans             &trans                         &trans       &trans                &trans                 &trans         &trans             &trans
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp QUESTION       &kp PIPE                       &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp BACKSLASH      &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &trans  &trans  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT    &trans  &trans  &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SINGLE_QUOTE   &trans
&trans  &trans           &trans         &trans            &trans             &trans         &trans  &trans  &trans       &trans                &trans                 &trans         &trans             &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans  &trans           &trans                       &trans         &trans         &trans    &trans      &trans         &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4           &kp F5                       &kp PAGE_UP    &kp BACKSPACE  &kp UP    &kp DELETE  &trans         &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9           &kp F10      &trans  &trans  &kp HOME       &kp LEFT       &kp DOWN  &kp RIGHT   &mt RCTRL END  &trans
&trans  &kp F11  &kp F12  &none   &kp PRINTSCREEN  &kp C_PAUSE  &trans  &trans  &kp PAGE_DOWN  &trans         &trans    &trans      &trans         &trans
&trans  &trans   &trans   &trans  &trans           &trans       &trans  &trans  &trans         &trans         &trans    &trans      &trans         &trans
            >;
        };
    };
};
