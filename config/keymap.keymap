#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <33 34>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <34 35>;
        };

        WheelClick {
            bindings = <&mkp MB3>;
            key-positions = <33 35>;
        };

        BrowserBack {
            bindings = <&mkp MB4>;
            key-positions = <19 20>;
        };

        BrowserForward {
            bindings = <&mkp MB5>;
            key-positions = <20 21>;
        };
    };

    behaviors {
        mt_balanced: mt_balanced {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&none           &none      &none         &none         &none  &none                                          &none  &none  &none      &none             &none             &none
&kp TAB         &kp Q      &kp W         &kp E         &kp R  &kp T                                          &kp Y  &kp U  &kp I      &kp O             &kp P             &kp BSPC
&kp LANGUAGE_2  &kp A      &kp S         &kp D         &kp F  &kp G  &none                 &none             &kp H  &kp J  &kp K      &kp L             &mt LCTRL MINUS   &kp LANGUAGE_1
&kp LSHFT       &kp Z      &kp X         &kp C         &kp V  &kp B  &kp ESC               &kp ESC           &kp N  &kp M  &kp COMMA  &kp DOT           &msc MOVE_Y(300)   &kp RSHFT
&kp LCTRL       &kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &mo 1  &mo 2  &mt LEFT_SHIFT SPACE  &mt RSHIFT ENTER  &mo 3  &none  &none      &msc MOVE_X(-300)  &msc MOVE_Y(-300)  &msc MOVE_X(300)
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &trans  &trans  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans   &trans   &trans  &trans           &trans                       &trans         &trans         &trans    &trans      &trans         &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4           &kp F5                       &kp PAGE_UP    &kp BACKSPACE  &kp UP    &kp DELETE  &trans         &trans
&trans  &kp F6   &kp F7   &kp F8  &kp F9           &kp F10      &trans  &trans  &kp HOME       &kp LEFT       &kp DOWN  &kp RIGHT   &mt RCTRL END  &trans
&trans  &kp F11  &kp F12  &none   &kp PRINTSCREEN  &kp C_PAUSE  &trans  &trans  &kp PAGE_DOWN  &trans         &trans    &trans      &trans         &trans
&trans  &trans   &trans   &trans  &trans           &trans       &trans  &trans  &trans         &trans         &trans    &trans      &trans         &trans
            >;
        };
    };
};
